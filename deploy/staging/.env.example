# deploy/staging/.env.example
#
# PURPOSE: Documentation only — lists every variable the staging environment requires.
# USAGE:   Copy to /opt/shuvmarg/staging/.env on the Oracle VM and fill in real values.
#          chmod 600 /opt/shuvmarg/staging/.env
#
# NEVER commit this file with real values.
# NEVER share secrets via this file — it is committed to version control.

# ── Deployment (Compose and deploy.sh) ───────────────────────────────────────
# Full GHCR image reference including SHA tag:
# e.g. ghcr.io/dipesh600/shuvmarg-bus-booking-platform-backend:sha-abc1234
BACKEND_IMAGE=ghcr.io/dipesh600/shuvmarg-bus-booking-platform-backend:sha-replace

# Public hostname for this staging backend:
STAGING_API_DOMAIN=api-staging.shuvmarg.com

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
DEPLOYMENT_ENV=staging
PORT=7012
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
# Must point to the STAGING Atlas cluster — never the production cluster.
MONGODB_URL=

# ── Authentication / JWT ──────────────────────────────────────────────────────
SECRET_KEY=replace-with-strong-random-secret-min-32-chars
VERIFICATION_TOKEN_SECRET=replace-with-separate-strong-random-secret-min-32-chars
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_MFA_ENCRYPTION_KEY=

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
FRONTEND_URL=https://staging.shuvmarg.com
OPERATOR_APP_URL=https://operator-staging.shuvmarg.com
TEMPORARY_CREDENTIAL_TTL_HOURS=24

# ── SMS (Sparrow SMS) ─────────────────────────────────────────────────────────
SPARROW_SMS_TOKEN=replace
SPARROW_SMS_FROM=TheAlert
# Durable business SMS starts disabled. Enable only after confirming the outbox
# indexes and queue records in staging. Keep the first pilot invitation-only.
SMS_OUTBOX_WORKER_ENABLED=false
SMS_OUTBOX_ENABLED_TYPES=AGENT_INVITATION,CREW_INVITATION

# ── Email (SMTP / Gmail) ──────────────────────────────────────────────────────
EMAIL_SERVICES=gmail
HOST=smtp.gmail.com
EMAIL_PORT=465
USER_EMAIL=replace@example.com
USER_PASSWORD=

# ── Push Notifications (Firebase; optional) ──────────────────────────────────
FCM_PROJECT_ID=replace
FCM_CLIENT_EMAIL=replace
# Preserve escaped newlines; the application converts \n at runtime.
FCM_PRIVATE_KEY=replace

# ── Cloud Storage (AWS S3) ────────────────────────────────────────────────────
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=replace
AWS_SECRET_ACCESS_KEY=replace
AWS_S3_BUCKET_NAME=replace-staging-bucket

# ── KYC malware scanning (required whenever NODE_ENV=production) ─────────────
# clamd must be reachable only over a trusted private network.
KYC_MALWARE_SCAN_MODE=required
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=30000

# ── Cloud Storage (Cloudinary) ────────────────────────────────────────────────
CLOUDINARY_NAME=replace
CLOUDINARY_API_KEY=replace
CLOUDINARY_SECRET_KEY=replace

# ── Payments (eSewa) ──────────────────────────────────────────────────────────
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=replace
PASSENGER_APP_URL=https://staging.shuvmarg.com

# ── Maps / External APIs ──────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=replace
MAPBOX_SECRET_TOKEN=replace

# ── Operational Alerts (optional) ─────────────────────────────────────────────
ADMIN_ALERT_USER_ID=replace-with-staging-admin-user-id
